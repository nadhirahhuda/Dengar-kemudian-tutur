  <style>
    :root {
      --ink: #25405c;
      --sky: #dff4ff;
      --paper: #fffdf7;
      --coral: #ff7764;
      --sun: #ffd45c;
      --mint: #bfeccf;
      --line: #d5e7ed;
    }

    * { box-sizing: border-box; }
    html { background: #dff4ff; }
    body {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      margin: 0;
      color: var(--ink);
      font-family: "Alegreya Sans", sans-serif;
      overflow-x: hidden;
    }

    .app-shell {
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      position: relative;
      isolation: isolate;
      padding: 24px;
      background:
        radial-gradient(circle at 9% 8%, rgba(255,255,255,.88) 0 28px, transparent 29px),
        radial-gradient(circle at 88% 14%, rgba(255,255,255,.76) 0 42px, transparent 43px),
        linear-gradient(145deg, #dff4ff 0%, #f7fbdf 100%);
    }

    .app-shell::before,
    .app-shell::after {
      content: "";
      position: absolute;
      z-index: -1;
      border-radius: 50%;
      opacity: .42;
    }
    .app-shell::before {
      width: 220px; height: 220px; background: #ffd869;
      right: -90px; bottom: 5%;
    }
    .app-shell::after {
      width: 180px; height: 180px; background: #ffb9ab;
      left: -80px; top: 38%;
    }

    .game-frame {
      width: 100%;
      max-width: 1060px;
      margin: 0 auto;
    }

    .cloud-card {
      border: 3px solid rgba(255,255,255,.9);
      box-shadow: 0 14px 0 rgba(76, 129, 153, .12), 0 22px 35px rgba(60, 111, 135, .13);
      border-radius: 32px;
    }

    .fun-title {
      font-family: "Fraunces", serif;
      letter-spacing: -0.035em;
    }

    .screen { display: none; }
    .screen.is-active { display: block; animation: screenIn .35s ease-out both; }
    @keyframes screenIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .start-illustration {
      width: 122px;
      height: 122px;
      border-radius: 36px;
      background: #fff1b8;
      display: grid;
      place-items: center;
      transform: rotate(-4deg);
      box-shadow: inset 0 -8px 0 rgba(235,174,55,.17);
    }

    .input-field {
      width: 100%;
      border: 2px solid var(--line);
      border-radius: 16px;
      padding: 13px 15px;
      font-size: 1.18rem;
      color: var(--ink);
      background: #fff;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .input-field:focus {
      border-color: #65b8d8;
      box-shadow: 0 0 0 4px rgba(101,184,216,.2);
    }

    .primary-action {
      border: 0;
      border-radius: 18px;
      padding: 16px 24px;
      font-weight: 800;
      font-size: 1.28rem;
      cursor: pointer;
      transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
      box-shadow: 0 7px 0 rgba(179, 68, 55, .42);
    }
    .primary-action:hover { transform: translateY(-2px); filter: brightness(1.03); }
    .primary-action:active { transform: translateY(4px); box-shadow: 0 3px 0 rgba(179, 68, 55, .42); }
    .primary-action:focus-visible,
    .choice-card:focus-visible,
    .listen-action:focus-visible,
    .file-picker:focus-visible {
      outline: 4px solid #244f70;
      outline-offset: 4px;
    }
    .primary-action:disabled,
    .listen-action:disabled {
      cursor: not-allowed;
      opacity: .55;
      transform: none;
      box-shadow: none;
    }

    .progress-pill {
      background: rgba(255,255,255,.82);
      border: 2px solid rgba(126,181,205,.32);
      border-radius: 999px;
      padding: 7px 14px;
      font-weight: 800;
    }

    .progress-track {
      height: 12px;
      border-radius: 999px;
      overflow: hidden;
      background: #d9edf3;
    }
    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #6ecf9a, #90ddcb);
      transition: width .3s ease;
    }

    .audio-box {
      border: 2px dashed #86c9dc;
      border-radius: 22px;
      background: #effbff;
      padding: 17px;
    }

    .file-picker {
      width: 100%;
      color: #456a7e;
      font-size: .98rem;
      cursor: pointer;
    }
    .file-picker::file-selector-button {
      border: 0;
      border-radius: 10px;
      padding: 8px 11px;
      margin-right: 10px;
      background: #cbeefa;
      color: #285f79;
      font-family: inherit;
      font-weight: 800;
      cursor: pointer;
    }

    .listen-action {
      border: 0;
      border-radius: 16px;
      padding: 13px 20px;
      font: inherit;
      font-size: 1.14rem;
      font-weight: 800;
      color: #fff;
      background: #347ea3;
      cursor: pointer;
      box-shadow: 0 5px 0 #256480;
      transition: transform .18s ease;
    }
    .listen-action:hover { transform: translateY(-2px); }
    .listen-action:active { transform: translateY(3px); box-shadow: 0 2px 0 #256480; }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 15px;
    }
    .choice-card {
      min-height: 172px;
      border: 3px solid #e1edf0;
      border-radius: 24px;
      background: #fff;
      padding: 15px 10px;
      cursor: pointer;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: inherit;
      font-size: 1.23rem;
      font-weight: 800;
      box-shadow: 0 6px 0 rgba(67, 126, 149, .12);
      transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }
    .choice-card:hover { transform: translateY(-4px); border-color: #8dcfe1; }
    .choice-card:active { transform: translateY(2px); }
    .choice-card.is-wrong { animation: shake .3s ease; border-color: #ff957f; background: #fff2ed; }
    .choice-card.is-correct { border-color: #5bbd81; background: #effff2; transform: translateY(-3px); }
    .choice-card:disabled { cursor: default; }
    @keyframes shake {
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }
    .object-icon {
      font-size: 4rem;
      line-height: 1;
      filter: drop-shadow(0 4px 0 rgba(55, 96, 114, .12));
    }

    .feedback {
      min-height: 58px;
      border-radius: 17px;
      padding: 14px 18px;
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 1.22rem;
      font-weight: 800;
      text-align: center;
    }
    .feedback.is-visible { display: flex; animation: popIn .28s ease-out; }
    @keyframes popIn {
      from { transform: scale(.93); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .correct-note { background: #e6faeb; color: #257047; border: 2px solid #9bd9ac; }
    .retry-note { background: #fff6dc; color: #8c6310; border: 2px solid #f1cf70; }

    .star-pop {
      position: fixed;
      z-index: 20;
      pointer-events: none;
      font-size: 2.4rem;
      animation: starFly .75s ease-out forwards;
    }
    @keyframes starFly {
      from { opacity: 0; transform: translateY(10px) scale(.5) rotate(-20deg); }
      45% { opacity: 1; transform: translateY(-26px) scale(1.22) rotate(12deg); }
      to { opacity: 0; transform: translateY(-60px) scale(.85) rotate(25deg); }
    }

    .result-medal {
      width: 125px;
      height: 125px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #fff2b6;
      border: 7px solid #fff9dd;
      margin: 0 auto;
      box-shadow: 0 8px 0 rgba(210,154,38,.24);
      font-size: 4rem;
    }

    .teacher-note {
      border-left: 5px solid #77c9dd;
      background: #eefaff;
      border-radius: 0 16px 16px 0;
    }

    @media (max-width: 680px) {
      .app-shell { padding: 15px; }
      .cloud-card { border-radius: 25px; }
      .choice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
      .choice-card { min-height: 142px; font-size: 1.08rem; }
      .object-icon { font-size: 3.3rem; }
      .start-illustration { width: 96px; height: 96px; border-radius: 28px; }
    }
  </style>
