  </div>
  <script>
    const questions = 5;
    let currentQuestion = 0;
    let score = 0;
    let hadWrongAttempt = false;
    let listenUses = 0;
    let audioBuffer = null;
    let audioContext = null;
    let student = { name: "", className: "", date: "" };

    const screens = {
      start: document.getElementById("start-screen"),
      game: document.getElementById("game-screen"),
      result: document.getElementById("result-screen")
    };

    const audioFile = document.getElementById("audio-file");
    const listenButton = document.getElementById("listen-button");
    const listenCount = document.getElementById("listen-count");
    const audioMessage = document.getElementById("audio-message");
    const fileStatus = document.getElementById("audio-file-status");
    const nextButton = document.getElementById("next-button");

    function showScreen(name) {
      Object.values(screens).forEach(screen => screen.classList.remove("is-active"));
      screens[name].classList.add("is-active");
    }

    function formatDate(value) {
      if (!value) return "";
      const date = new Date(value + "T00:00:00");
      return date.toLocaleDateString("ms-MY", { day: "numeric", month: "long", year: "numeric" });
    }

    function resetAudioArea() {
      listenUses = 0;
      audioBuffer = null;
      audioFile.value = "";
      fileStatus.textContent = "Belum ada rakaman dipilih.";
      audioMessage.classList.add("hidden");
      listenButton.disabled = false;
      updateListenCount();
    }

    function updateListenCount() {
      listenCount.textContent = "🔊 " + listenUses + "/2 kali digunakan";
      if (listenUses >= 2) {
        listenButton.disabled = true;
      }
    }

    function updateGameView() {
      document.querySelectorAll(".question-card").forEach((card, index) => {
        card.classList.toggle("hidden", index !== currentQuestion);
      });

      document.getElementById("question-count").textContent = "Soalan " + (currentQuestion + 1) + " daripada " + questions;
      document.getElementById("score-display").textContent = score;
      document.getElementById("progress-fill").style.width = ((currentQuestion + 1) / questions * 100) + "%";

      document.getElementById("correct-feedback").classList.remove("is-visible");
      document.getElementById("retry-feedback").classList.remove("is-visible");
      nextButton.classList.add("hidden");

      const activeCard = document.getElementById("question-card-" + (currentQuestion + 1));
      activeCard.querySelectorAll(".choice-card").forEach(button => {
        button.disabled = false;
        button.classList.remove("is-wrong", "is-correct");
      });

      hadWrongAttempt = false;
      resetAudioArea();
    }

    function showAudioMessage(message) {
      audioMessage.textContent = message;
      audioMessage.classList.remove("hidden");
    }

    function playStar() {
      const star = document.createElement("span");
      star.className = "star-pop";
      star.textContent = "⭐";
      star.style.left = "calc(50% + " + (Math.random() * 70 - 35) + "px)";
      star.style.top = "44%";
      document.body.appendChild(star);
      star.addEventListener("animationend", () => star.remove());
    }

    async function decodeSelectedAudio(file) {
      try {
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        const data = await file.arrayBuffer();
        audioBuffer = await audioContext.decodeAudioData(data);
        fileStatus.textContent = "Rakaman dipilih: " + file.name;
        audioMessage.classList.add("hidden");
      } catch (error) {
        audioBuffer = null;
        fileStatus.textContent = "Fail audio tidak dapat dibuka.";
        showAudioMessage("Sila pilih fail audio lain yang sesuai.");
      }
    }

    audioFile.addEventListener("change", () => {
      const file = audioFile.files[0];
      if (file) decodeSelectedAudio(file);
    });

    listenButton.addEventListener("click", async () => {
      if (listenUses >= 2) return;

      if (!audioBuffer) {
        showAudioMessage("Guru: sila pilih rakaman suara manusia terlebih dahulu.");
        return;
      }

      if (audioContext.state === "suspended") {
        await audioContext.resume();
      }

      const source = audioContext.createBufferSource();
      source.buffer = audioBuffer;
      source.connect(audioContext.destination);
      source.start(0);

      listenUses += 1;
      updateListenCount();
      audioMessage.classList.add("hidden");
    });

    document.querySelectorAll(".choice-card").forEach(button => {
      button.addEventListener("click", () => {
        const activeQuestion = document.getElementById("question-card-" + (currentQuestion + 1));
        if (!activeQuestion.contains(button) || button.disabled) return;

        const correctFeedback = document.getElementById("correct-feedback");
        const retryFeedback = document.getElementById("retry-feedback");

        if (button.dataset.correct === "true") {
          const points = hadWrongAttempt ? 1 : 2;
          score += points;
          document.getElementById("score-display").textContent = score;
          button.classList.add("is-correct");
          activeQuestion.querySelectorAll(".choice-card").forEach(option => option.disabled = true);
          retryFeedback.classList.remove("is-visible");
          correctFeedback.classList.add("is-visible");
          nextButton.classList.remove("hidden");
          playStar();
        } else {
          hadWrongAttempt = true;
          button.classList.add("is-wrong");
          retryFeedback.classList.add("is-visible");
          setTimeout(() => button.classList.remove("is-wrong"), 420);
        }
      });
    });

    nextButton.addEventListener("click", () => {
      currentQuestion += 1;
      if (currentQuestion < questions) {
        updateGameView();
      } else {
        document.getElementById("result-student-name").textContent = "🌟 Syabas, " + student.name + "!";
        document.getElementById("result-score").textContent = "⭐ " + score + " / 10";
        const details = [student.className, formatDate(student.date)].filter(Boolean).join(" • ");
        document.getElementById("result-details").textContent = details;
        showScreen("result");
      }
    });

    document.getElementById("student-form").addEventListener("submit", (event) => {
      event.preventDefault();
      const name = document.getElementById("student-name").value.trim();
      const className = document.getElementById("student-class").value.trim();
      const date = document.getElementById("student-date").value;
      const error = document.getElementById("start-error");

      if (!name) {
        error.textContent = "Sila isi nama murid dahulu.";
        error.classList.remove("hidden");
        document.getElementById("student-name").focus();
        return;
      }

      error.classList.add("hidden");
      student = { name, className, date };
      currentQuestion = 0;
      score = 0;
      updateGameView();
      showScreen("game");
    });

    document.getElementById("restart-button").addEventListener("click", () => {
      document.getElementById("student-form").reset();
      document.getElementById("start-error").classList.add("hidden");
      showScreen("start");
    });

    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
    });
  </script>
