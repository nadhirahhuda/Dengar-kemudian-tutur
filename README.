          <button type="button" class="choice-card" data-correct="false"><span class="object-icon">🎒</span><span data-template-id="q3-option-bag" class="canva-text"></span></button> <button type="button" class="choice-card" data-correct="true"><span class="object-icon">⚽</span><span data-template-id="q3-option-ball" class="canva-text"></span></button> <button type="button" class="choice-card" data-correct="false"><span class="object-icon">📚</span><span data-template-id="q3-option-book" class="canva-text"></span></button> <button type="button" class="choice-card" data-correct="false"><span class="object-icon">🐱</span><span data-template-id="q3-option-cat" class="canva-text"></span></button>
